// Esquema de nutralab-vlc (tablas del esquema `teams`; la BD se comparte con nutralab).
// Migraciones: npm run db:migration -- nombre  →  revisar SQL  →  npm run db:migrate
// NUNCA usar `prisma migrate dev` ni `prisma db push`: ante diferencias pueden proponer
// resetear el esquema y borrar los datos. (`npm run db:pull` borra este comentario: reponerlo.)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analiticas {
  id                   BigInt    @id @default(autoincrement())
  jugador_id           BigInt
  fecha_extraccion     DateTime? @db.Date
  parametros           Json      @default("[]")
  pdf_nombre           String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  visible_para_jugador Boolean?  @default(false)
  jugadores            jugadores @relation(fields: [jugador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jugador_id], map: "teams_analiticas_jugador_id_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model comidas {
  id          BigInt    @id @default(autoincrement())
  jugador_id  BigInt
  taken_at    DateTime  @default(now()) @db.Timestamptz(6)
  dish_name   String?
  meal_type   String
  ingredients String[]  @default([])
  calories    Int?
  notes       String?
  photo       Bytes?
  photo_mime  String?   @default("image/webp")
  photo_size  Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  jugadores   jugadores @relation(fields: [jugador_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jugador_id, taken_at], map: "teams_comidas_jugador_taken_at_idx")
}

