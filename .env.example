# ── IA (OpenRouter - ChatGPT Luna 6 Pro) ──
OPEN_ROUTER_API=
AI_MODEL=openai/gpt-6-luna-pro

# ── Supabase & Base de Datos ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=teams
SUPABASE_DB_URL=

# ── Autenticación y URLs ──
JWT_SECRET=
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ── Facturación y Tokens de API Externa ──
BILLING_SERVICE_URL=http://localhost:3005
BILLING_API_KEY=
EXTERNAL_API_KEY_HYBRID=
# Tokens de API externa por tenant (EXTERNAL_API_KEY_<TENANT>), o mapa JSON en EXTERNAL_API_KEYS
# Orígenes permitidos por CORS para la API externa (coma-separados). Vacío = cualquiera (auth por Bearer)
EXTERNAL_API_ALLOWED_ORIGINS=

# ── Seguridad ──
# En producción JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY y las URLs/keys de Supabase son OBLIGATORIAS
# (la app no arranca sin ellas). Genera JWT_SECRET con: openssl rand -hex 32
# NUNCA definir BONEYARD_MODE en producción (en producción se ignora igualmente).
