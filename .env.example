# ── IA (OpenRouter - ChatGPT Luna 6 Pro) ──
OPEN_ROUTER_API=
AI_MODEL=openai/gpt-6-luna-pro

# ── Base de datos (Neon, misma BD que nutralab; esta app usa el esquema teams) ──
# Mismas credenciales que nutralab, pero con schema=teams.
# Conexión con pooler (host con -pooler) para la app:
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1&schema=teams"
# Conexión directa (host sin -pooler) para Prisma Migrate (npm run db:migrate):
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&schema=teams"

# ── Autenticación y URLs ──
JWT_SECRET=
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ── Facturación y Tokens de API Externa ──
BILLING_SERVICE_URL=http://localhost:3005
BILLING_API_KEY=
EXTERNAL_API_KEY_HYBRID=
# Tokens de API externa por tenant (EXTERNAL_API_KEY_<TENANT>), o mapa JSON en EXTERNAL_API_KEYS
# Orígenes permitidos por CORS para la API externa (coma-separados). Vacío = cualquiera (auth por Bearer)
EXTERNAL_API_ALLOWED_ORIGINS=

# ── Seguridad ──
# En producción JWT_SECRET, DATABASE_URL y DIRECT_URL son OBLIGATORIAS
# (la app no arranca sin ellas). Genera JWT_SECRET con: openssl rand -hex 32
# NUNCA definir BONEYARD_MODE en producción (en producción se ignora igualmente).
